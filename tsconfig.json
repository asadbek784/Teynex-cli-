{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "src/cli.ts",
    "src/types.ts",
    "src/config.ts",
    "src/security.ts",
    "src/agent/agent.ts",
    "src/agent/planner.ts",
    "src/project/**/*.ts",
    "src/tools/filesystem.ts",
    "src/tools/shell.ts",
    "src/ui/console.ts",
    "tests/**/*.ts"
  ]
}
